{
  "name": "faturometro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:parsers": "vitest run src/parsers",
    "icons": "pwa-assets-generator",
    "fixture:anon": "tsx scripts/anonymize-fixture.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:4173",
    "fixtures:synthetic": "tsx scripts/synthetic-fixtures.ts",
    "erse:sync": "tsx scripts/erse-sync.ts",
    "comescolha:check": "tsx scripts/comescolha-check.ts",
    "deploy:app": "pnpm build && wrangler deploy -c wrangler.app.toml",
    "deploy:server": "wrangler deploy -c server/wrangler.toml",
    "ai:eval": "tsx scripts/ai-eval.ts",
    "parser:generate": "tsx scripts/generate-parser.ts",
    "contrib:keygen": "tsx scripts/contrib-keygen.ts",
    "contributions:pull": "tsx scripts/contributions-pull.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5",
    "zod": "^4.6.7",
    "zxing-wasm": "^3.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.157.0"
  },
  "packageManager": "pnpm@12.11.2",
  "license": "AGPL-3.0-or-later",
  "author": "Paulo Barbosa"
}
